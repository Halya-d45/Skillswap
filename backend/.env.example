# SkillSwap Backend Environment Variables Example
# Copy this file to .env and insert your real MongoDB Atlas connection string & Gmail credentials

PORT=5001
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/skillswap?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here

# Resend HTTP API Configuration
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL="SkillSwap <onboarding@resend.dev>"

# Gmail SMTP Configuration for Nodemailer (Google App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
